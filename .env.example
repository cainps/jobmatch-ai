# Copie para .env e troque os valores:  cp .env.example .env
# NUNCA faça commit do arquivo .env.

# Banco de dados
DB_ROOT_PASSWORD=troque-esta-senha-root
DB_PASSWORD=troque-esta-senha-app
# DB_NAME=jobmatch
# DB_USER=jobmatch

# Painel admin (PHP) - http://localhost:8080
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha-admin

# IA: deixe vazio para usar a análise local por palavras-chave.
# Chave da API da Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Portas publicadas no host
# WEB_PORT=80
# ADMIN_PORT=8080
